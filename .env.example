# Database (Supabase Postgres)
DATABASE_URL="postgres://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_ID].supabase.co:6543/postgres?pgbouncer=true"

# Supabase (Real-time & Admin)
PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
PUBLIC_SUPABASE_ANON_KEY="[YOUR_ANON_KEY]"
SUPABASE_JWT_SECRET="[YOUR_JWT_SECRET]" # Keep this in private env only

# AI connector OAuth (private Vercel variables, separate per environment)
LIST_OAUTH_ISSUER="https://your-list.example"
LIST_MCP_RESOURCE="https://your-list.example/mcp"
LIST_OAUTH_CLIENTS='[{"id":"chat-client-id","name":"Chat app","secret":"replace-with-a-random-secret-of-32-or-more-characters","redirectUris":["https://chat-client.example/oauth/callback"],"authenticationMethod":"client_secret_post","scopes":["lists:read","proposals:create","offline_access"]}]'
