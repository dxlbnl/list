# Test/CI environment defaults (committed, non-secret placeholders).
# Loaded by Vitest (test mode) and by `svelte-kit sync --mode test` so
# `$env/static/public` types generate and modules import cleanly under test.
DATABASE_URL="postgres://test:test@localhost:5432/test"
PUBLIC_SUPABASE_URL="https://test.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="test-anon-key"
SUPABASE_JWT_SECRET="test-jwt-secret"
SUPABASE_JWT_KID="test-kid"
RESEND_API_KEY="test-resend-key"
